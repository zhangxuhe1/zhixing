# cp .env.production.example .env.production 并把所有密钥改为强随机值（openssl rand -hex 24）
ZHIXING_DOMAIN=zhixing.example.com
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me
S3_SECRET_KEY=change-me
APPLE_BUNDLE_ID=app.zhixing.ios

# 分享落地页（GET /app-config 下发给 iOS，分享链接指向这里）——上线前换成正式落地页地址
SHARE_LANDING_URL=https://zhixing.example.com/beta

# 反向代理（本栈为 Caddy；Nginx 同理）后面部署必须开启（=1），Fastify 才会信任
# X-Forwarded-For 解析真实客户端 IP——否则限流按代理 IP 计数，全站同桶，任何
# 一个用户刷请求都会把所有人打进 429。仅 api 直连公网（无反代）时才可设 0。
TRUST_PROXY=1

# MinIO root 凭据（可选覆盖；不设则 user=zhixing、password=S3_SECRET_KEY）。
# compose.prod.yml 中 api 的 S3_ACCESS_KEY/S3_SECRET_KEY 会自动跟随这两个值，无需手动同步。
# MINIO_ROOT_USER=zhixing
# MINIO_ROOT_PASSWORD=change-me

# 邮箱验证码发信（SMTP）：留空 = 验证码只打印到 api 容器日志，不真实发信；
# 生产环境必须配置为真实 smtps:// 连接串才能发出验证码邮件；
# 凭据中若含 @ : / 等特殊字符需做 URL 编码。
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# 发信人；默认 `知行 <noreply@example.com>`，发信域名需配置 SPF/DKIM，否则易被判垃圾邮件。
# MAIL_FROM=知行 <noreply@example.com>
