generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaceLevel {
  PROVINCE
  CITY
  DISTRICT // 区县 / 古镇 / 街区
  POI
}

enum CardCategory {
  CUSTOMS // 习俗
  FOOD // 吃食
  DIALECT // 方言
  ANECDOTE // 掌故
  PLACE_NAME // 地名由来
}

enum CardStatus {
  AI_GENERATED // AI 整理·待复核（可上架，卡面带标识）
  REVIEWED // 已人工复核
  RETIRED // 下架
}

enum BlockType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum IdentityProvider {
  APPLE
  EMAIL
}

enum LinkPlatform {
  XIAOHONGSHU
  BILIBILI
  DOUYIN
  WEIBO
  OTHER
}

enum PlaceStatus {
  ACTIVE // 官方/审核通过,全网可见
  PENDING // 用户申请待审,仅本人可见
  REJECTED // 审核未通过,仅本人可见(其上足迹保留私有)
}

model Place {
  id          String      @id @default(cuid())
  name        String
  level       PlaceLevel
  parentId    String?
  parent      Place?      @relation("PlaceTree", fields: [parentId], references: [id])
  children    Place[]     @relation("PlaceTree")
  lat         Float
  lng         Float
  intro       String?
  cards       Card[]
  footprints  Footprint[]
  links       PlaceLink[]
  status      PlaceStatus @default(ACTIVE)
  createdById String?
  createdBy   User?       @relation("UserCreatedPlaces", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@unique([name, parentId])
  @@index([level])
  @@index([status])
}

// 地点外链(小红书/B 站等攻略帖):第一期仅管理员维护;独立表而非 JSON,
// 排序/增删与未来"用户提交+审核"演进都不再动 schema。
model PlaceLink {
  id        String       @id @default(cuid())
  placeId   String
  place     Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  platform  LinkPlatform
  title     String
  url       String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([placeId])
}

model Card {
  id        String         @id @default(cuid())
  placeId   String
  place     Place          @relation(fields: [placeId], references: [id])
  category  CardCategory
  title     String
  status    CardStatus     @default(AI_GENERATED)
  sources   Json // string[] 参考来源
  blocks    CardBlock[]
  favorites CardFavorite[]
  reports   CardReport[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([placeId, status])
}

model CardBlock {
  id       String    @id @default(cuid())
  cardId   String
  card     Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  order    Int
  type     BlockType
  text     String? // TEXT 块内容
  mediaUrl String? // IMAGE/AUDIO/VIDEO 块的媒体地址（M0 预留）

  @@unique([cardId, order])
}

model User {
  id            String         @id @default(cuid())
  nickname      String
  createdAt     DateTime       @default(now())
  footprints    Footprint[]
  likes         Like[]
  favorites     CardFavorite[]
  reports       CardReport[]
  trips         Trip[]
  identities    Identity[]
  createdPlaces Place[]        @relation("UserCreatedPlaces")
}

model Identity {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  subject   String           // APPLE = identityToken 的 sub；EMAIL = normalizeEmail 后的邮箱
  createdAt DateTime         @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String // normalizeEmail 后的地址
  code      String // 6 位数字
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Footprint {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  placeId           String
  place             Place            @relation(fields: [placeId], references: [id])
  text              String?
  date              DateTime
  visibility        Visibility       @default(PRIVATE)
  reviewStatus      ReviewStatus     @default(PENDING)
  likeCount         Int              @default(0)
  viewCount         Int              @default(0)
  photos            FootprintPhoto[]
  likes             Like[]
  tripId            String?
  trip              Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  publicRequestedAt DateTime? // 进审核队列时间，排序用
  createdAt         DateTime         @default(now())

  @@index([placeId, visibility])
  @@index([userId])
  @@index([visibility, reviewStatus])
}

model FootprintPhoto {
  id          String    @id @default(cuid())
  footprintId String
  footprint   Footprint @relation(fields: [footprintId], references: [id], onDelete: Cascade)
  mediaUrl    String
  takenAt     DateTime?
  lat         Float? // 原始坐标；公开展示时由服务端脱敏到地点级
  lng         Float?
}

model SearchMiss {
  id     String   @id @default(cuid())
  query  String   @unique
  count  Int      @default(1)
  lastAt DateTime @updatedAt
}

model Like {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  footprintId String
  footprint   Footprint @relation(fields: [footprintId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, footprintId])
  @@index([footprintId])
}

model CardFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cardId])
}

model CardReport {
  id        String       @id @default(cuid())
  cardId    String
  card      Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([status])
}

model Trip {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  startDate  DateTime
  endDate    DateTime
  footprints Footprint[]
  createdAt  DateTime    @default(now())

  @@index([userId])
}
